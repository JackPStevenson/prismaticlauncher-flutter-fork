# Linux validation image for the Flutter build. It runs format, analyzer, and tests; it is
# not a production image and does not build the GTK desktop binary.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
# Pin the SDK to the release this port was verified with.
ARG FLUTTER_VERSION=3.50.0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        git \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash builder \
    && mkdir /workspace \
    && chown builder:builder /workspace

USER builder
RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git /home/builder/flutter \
    && /home/builder/flutter/bin/flutter config --no-analytics \
    && /home/builder/flutter/bin/flutter precache --no-android --no-ios --no-web
ENV PATH="/home/builder/flutter/bin:${PATH}"

WORKDIR /workspace
COPY --chown=builder:builder . /workspace

CMD ["bash", "scripts/ci-linux.sh"]
